<Window
    x:Class="TarkovAssistant.App.Views.MessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TarkovAssistant.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    MinWidth="320"
    MinHeight="180"
    MaxWidth="540"
    MaxHeight="320"
    d:Title="Message"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <Border
        Background="{StaticResource DarkBaseBrush}"
        BorderBrush="{StaticResource MediumFocudedBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="20,20,20,0"
                VerticalAlignment="Center"
                d:Text="Example of an application message dialog box"
                Cursor=""
                Style="{StaticResource BaseText}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />

            <Grid
                Grid.Row="4"
                Height="Auto"
                Margin="5,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        MinWidth="75"
                        Background="{StaticResource BaseFocudedBrush}"
                        BorderBrush="{StaticResource BaseFocudedBrush}"
                        Command="{Binding ConfirmCommand}"
                        Content="OK"
                        IsDefault="True"
                        Style="{StaticResource SuccessTextButtonStyle}" />

                    <Button
                        MinWidth="75"
                        Margin="10,0,0,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource BaseTextButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
