<Window x:Class="TarkovAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"   
        xmlns:core="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TarkovAssistant.App"
        xmlns:vm="clr-namespace:TarkovAssistant.App.ViewModels"
        xmlns:lang="clr-namespace:TarkovAssistant.App.Localization"
        xmlns:b="clr-namespace:TarkovAssistant.App.Behaviors"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="{x:Static lang:Labels.Label_AppName}"         
        Left="{Binding FormInfo.Left, Mode=TwoWay}"
        Top="{Binding FormInfo.Top, Mode=TwoWay}"   
        Height="{Binding FormInfo.Height, Mode=TwoWay}"         
        Width="{Binding FormInfo.Width, Mode=TwoWay}"
        MinHeight="600"
        MinWidth="800"
        WindowStyle="{Binding FormInfo.WindowStyle, Mode=TwoWay}"
        ResizeMode="{Binding FormInfo.ResizeMode, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"               
        Background="{StaticResource MapBaseBrush}" 
        Cursor="">

    <Window.Resources>
        <CubicEase x:Key="Ease" EasingMode="EaseInOut"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>

    <Grid 
        Background="#0f0f0f"
        Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <i:Interaction.Behaviors>
            <b:ActualSizeBehavior ActualHeight="{Binding ContainerHeight, Mode=TwoWay}" />
            <b:ActualSizeBehavior ActualWidth="{Binding ContainerWidth, Mode=TwoWay}" />
        </i:Interaction.Behaviors>

        <!--#region <Actions> -->

        <Grid Grid.Column="0" Panel.ZIndex="1" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel 
                Orientation="Vertical"              
                Grid.Column="0"
                Grid.Row="0"  
                Width="Auto"   
                Margin="10,10,0,0">

                <Button Command="{Binding SelectMapCommand}" Style="{StaticResource IconButtonStyle}" Cursor="Hand">
                    <icons:PackIconMaterial Kind="Apps" Width="40" Height="40"/>
                </Button>

                <Button Command="{Binding ToggleFullScreenCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,20,0,0">
                    <icons:PackIconMaterial Kind="Fullscreen" Width="40" Height="40"/>
                </Button>

                <Button Command="{Binding ZoomInCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,10,0,0" >
                    <icons:PackIconMaterial Kind="MagnifyPlusOutline" Width="40" Height="40"/>
                </Button>

                <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,10,0,0">
                    <icons:PackIconMaterial Kind="MagnifyMinusOutline" Width="40" Height="40"/>
                </Button>

                <Button Command="{Binding CenterMapCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,10,0,0" Cursor="Hand">
                    <icons:PackIconMaterial Kind="ImageFilterCenterFocusStrong" Width="40" Height="40"/>
                </Button>

                <Button Command="{Binding ToggleMapFiltersCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,10,0,0" Cursor="Hand">
                    <icons:PackIconMaterial Kind="FilterCogOutline" Width="40" Height="40"/>
                </Button>
            </StackPanel>

            <Button 
                Command="{Binding OpenSettingsCommand}" 
                Style="{StaticResource IconButtonStyle}" 
                VerticalAlignment="Bottom"
                Grid.Column="0" 
                Grid.Row="1" 
                Margin="10,0,0,10" 
                Cursor="Hand">
                <icons:PackIconMaterial Kind="Cog" Width="40" Height="40"/>
            </Button>
        </Grid>

        <!--#endregion-->

        <!--#region <Map Container> -->

        <Canvas 
            Name="MapContainer"
            Grid.ColumnSpan="2"
            Panel.ZIndex="0"                         
            Cursor="" Grid.RowSpan="2">

            <Canvas
                Width="Auto" 
                Height="Auto"
                Canvas.Left="{Binding ContainerLeft}" 
                Canvas.Top="{Binding ContainerTop}" 
                Cursor="">

                <i:Interaction.Behaviors>
                    <b:DragBehavior />
                </i:Interaction.Behaviors>

                <Image
                    Canvas.Left="0" 
                    Canvas.Top="0"
                    Width="{Binding MapWidth, Mode=TwoWay}" 
                    Height="{Binding MapHeight, Mode=TwoWay}"       
                    Canvas.ZIndex ="0"
                    Cursor="ScrollAll"
                    Source="{Binding CurrentLayer.Picture}">
                </Image>

                <Canvas>
                    <ItemsControl ItemsSource="{Binding Markers}" Cursor="">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <Setter Property="Canvas.ZIndex" Value="1" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MarkerButtonStyle}" Visibility="{Binding Visibility, Mode=TwoWay}" >
                                    <icons:PackIconMaterial Kind="HelpCircle" Width="24" Height="24"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Canvas>
        </Canvas>
        <!--#endregion-->


        <!--#region <Map Selection Panel> -->

        <Border 
            Name="MapSelection"
            Grid.ColumnSpan="2"
            Grid.RowSpan="2"
            Height="Auto"
            Width="Auto"  
            MinHeight="220"
            MinWidth="600"
            MaxHeight="520"
            MaxWidth="1120"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"  
            Visibility="{Binding IsMapSelectionPanelVisible, Converter={StaticResource BoolToVisible}}"         
            Background="{StaticResource MediumBaseBrush}" 
            BorderBrush="{StaticResource LightBaseBrush}"
            BorderThickness="1"
            CornerRadius="6" 
            Margin="20"
            Padding="5"
            Panel.ZIndex ="2"  
            Cursor="">

            <ListBox   
                x:Name="MapListBox"
                ItemsSource="{Binding Maps}"
                SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                Background="{StaticResource MediumBaseBrush}" 
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                BorderThickness="0">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template" Value="{StaticResource MapListItems}" />
                    </Style>
                </ListBox.ItemContainerStyle>                
            </ListBox>
        </Border>

        <!--#endregion-->

        <!--#region <Filter Panel> -->

        <Border 
            Name="FilterPanel"
            Width="300"            
            HorizontalAlignment="Center"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource LightBaseBrush}" 
            BorderThickness="1"
            CornerRadius="6"  
            Margin="0,10,0,10"
            RenderTransformOrigin="0,0"
            Panel.ZIndex ="2" Cursor="" Grid.RowSpan="2">

            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTransform" X="-300"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2">
                    <TextBlock            
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}"
                        Margin="10,10,50,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Extractions_Label}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox 
                        ItemsSource="{Binding Extractions}"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectionMode="Multiple"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"                         
                        Cursor="">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="30 5 0 0">
                                    <Image Width="32" Source="{Binding Icon}" />
                                    <TextBlock Text="{Binding Name}" Cursor="Hand" Padding="2" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock            
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}"
                        Margin="10,20,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Quests_Label}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox 
                        ItemsSource="{Binding Quests}"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectionMode="Multiple"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}" 
                        Margin="0,0,0,0"
                        Cursor="">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="30 5 0 0">
                                    <TextBlock Text="{Binding Name}" Cursor="Hand" Padding="2" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <Button 
                    Command="{Binding ToggleMapFiltersCommand}" 
                    Style="{StaticResource IconButtonStyle}" 
                    Grid.Column="1" 
                    VerticalAlignment="Top"
                    Width="36" 
                    Height="36"
                    Cursor="Hand">
                    <icons:PackIconMaterial Kind="CloseBoxOutline" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MenuStates">
                <VisualState x:Name="Closed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="FilterPanelTransform"
                             Storyboard.TargetProperty="X"
                             To="-300" Duration="0:0:0.3"
                             EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Open">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="FilterPanelTransform"
                             Storyboard.TargetProperty="X"
                             To="10" Duration="0:0:0.3"
                             EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <i:Interaction.Triggers>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="True">
                <i:GoToStateAction StateName="Open"/>
            </i:DataTrigger>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="False">
                <i:GoToStateAction StateName="Closed"/>
            </i:DataTrigger>
        </i:Interaction.Triggers>

        <!--#endregion-->

    </Grid>
</Window>
