<Window
    x:Class="TarkovAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:TarkovAssistant.App.Behaviors"
    xmlns:core="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lang="clr-namespace:TarkovAssistant.App.Localization"
    xmlns:local="clr-namespace:TarkovAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TarkovAssistant.App.ViewModels"
    Title="{x:Static lang:Labels.AppName_Label}"
    Width="{Binding FormInfo.Width, Mode=TwoWay}"
    Height="{Binding FormInfo.Height, Mode=TwoWay}"
    MinWidth="800"
    MinHeight="600"
    Background="{StaticResource MapBaseBrush}"
    Cursor=""
    Left="{Binding FormInfo.Left, Mode=TwoWay}"
    ResizeMode="{Binding FormInfo.ResizeMode, Mode=TwoWay}"
    Top="{Binding FormInfo.Top, Mode=TwoWay}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="{Binding FormInfo.WindowStyle, Mode=TwoWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <CubicEase x:Key="Ease" EasingMode="EaseInOut" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </Window.Resources>

    <Grid Background="#0f0f0f" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <i:Interaction.Behaviors>
            <b:ActualSizeBehavior ActualHeight="{Binding InteractiveMap.ContainerHeight, Mode=TwoWay}" />
            <b:ActualSizeBehavior ActualWidth="{Binding InteractiveMap.ContainerWidth, Mode=TwoWay}" />
        </i:Interaction.Behaviors>

        <!--#region <Actions> -->

        <Grid
            Grid.RowSpan="2"
            Grid.Column="0"
            Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Width="Auto"
                Margin="10,10,0,0"
                Orientation="Vertical">

                <Button
                    Command="{Binding SelectMapCommand}"
                    Cursor="Hand"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="Apps" />
                </Button>

                <Button
                    Margin="0,20,0,0"
                    Command="{Binding ToggleFullScreenCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="Fullscreen" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ZoomInCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MagnifyPlusOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ZoomOutCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MagnifyMinusOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding CenterMapCommand}"
                    Cursor="Hand"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="ImageFilterCenterFocusStrong" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ToggleMapFiltersCommand}"
                    Cursor="Hand"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="FilterCogOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding TestCurrentPositionCommand}"
                    Cursor="Hand"
                    Style="{StaticResource IconButtonStyle}"
                    Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVisible}}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MapMarkerStarOutline" />
                </Button>
            </StackPanel>

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,0,0,10"
                VerticalAlignment="Bottom"
                Command="{Binding OpenSettingsCommand}"
                Cursor="Hand"
                Style="{StaticResource IconButtonStyle}">
                <icons:PackIconMaterial
                    Width="40"
                    Height="40"
                    Kind="Cog" />
            </Button>
        </Grid>

        <!--#endregion-->

        <!--#region <Map Container> -->

        <Canvas
            Name="MapContainer"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="0"
            Cursor="">

            <Canvas
                Canvas.Left="{Binding InteractiveMap.ContainerLeft}"
                Canvas.Top="{Binding InteractiveMap.ContainerTop}"
                Width="Auto"
                Height="Auto"
                Cursor="">

                <i:Interaction.Behaviors>
                    <b:DragBehavior />
                </i:Interaction.Behaviors>

                <Image
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="{Binding InteractiveMap.Width, Mode=TwoWay}"
                    Height="{Binding InteractiveMap.Height, Mode=TwoWay}"
                    Canvas.ZIndex="0"
                    Cursor="ScrollAll"
                    Source="{Binding InteractiveMap.CurrentLayer.Picture}" />

                <Canvas
                    Canvas.Left="{Binding InteractiveMap.CurrentPosition.Left}"
                    Canvas.Top="{Binding InteractiveMap.CurrentPosition.Top}"
                    Width="32"
                    Height="32"
                    Canvas.ZIndex="2"
                    Visibility="{Binding InteractiveMap.CurrentPosition.IsVisibile, Converter={StaticResource BoolToVisible}}">

                    <Canvas
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="32"
                        Height="32">
                        <Ellipse
                            Canvas.Left="6"
                            Canvas.Top="6"
                            Width="20"
                            Height="20"
                            Fill="Crimson" />
                        <Polygon
                            x:Name="Triangle"
                            Fill="Crimson"
                            Points="16,0 10,5 22,5"
                            Stroke="Crimson"
                            StrokeThickness="2" />

                        <Canvas.RenderTransform>
                            <RotateTransform Angle="{Binding InteractiveMap.CurrentPosition.Angle}" CenterX="16" CenterY="16" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </Canvas>

                <Canvas>
                    <ItemsControl Cursor="" ItemsSource="{Binding InteractiveMap.Markers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <Setter Property="Canvas.ZIndex" Value="1" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <!--
                         <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MarkerButtonStyle}" Visibility="{Binding Visibility, Mode=TwoWay}" >
                                    <icons:PackIconMaterial Kind="HelpCircle" Width="24" Height="24"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        -->

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image
                                    Width="32"
                                    Height="32"
                                    Cursor="Hand"
                                    Source="{Binding Picture}"
                                    Visibility="{Binding IsVisibile, Converter={StaticResource BoolToVisible}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </Canvas>
            </Canvas>
        </Canvas>
        <!--#endregion-->


        <!--#region <Map Selection Panel> -->

        <Border
            Name="MapSelection"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Width="Auto"
            Height="Auto"
            MinWidth="600"
            MinHeight="220"
            MaxWidth="1120"
            MaxHeight="520"
            Margin="20"
            Padding="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2"
            Background="{StaticResource MediumBaseBrush}"
            BorderBrush="{StaticResource LightBaseBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Cursor=""
            Visibility="{Binding IsMapSelectionPanelVisible, Converter={StaticResource BoolToVisible}}">

            <ListBox
                x:Name="MapListBox"
                Background="{StaticResource MediumBaseBrush}"
                BorderThickness="0"
                ItemsSource="{Binding Maps}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedMap, Mode=TwoWay}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template" Value="{StaticResource MapListItems}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!--#endregion-->

        <!--#region <Filter Panel> -->

        <Border
            Name="FilterPanel"
            Grid.RowSpan="2"
            Width="300"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            Panel.ZIndex="2"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource LightBaseBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Cursor=""
            RenderTransformOrigin="0,0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTransform" X="-300" />
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,10,50,0"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}">

                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Extractions_Label}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor=""
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        ItemContainerStyle="{StaticResource FilterListItems}"
                        ItemsSource="{Binding InteractiveMap.Extractions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Multiple">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="30,5,0,0" Orientation="Horizontal">
                                    <Image Width="32" Source="{Binding Icon}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        Padding="2"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat=" {0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="Markers.Count" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="2"
                        Margin="10,20,0,0"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Quests_Label}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox
                        Grid.Row="3"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor=""
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        ItemContainerStyle="{StaticResource FilterListItems}"
                        ItemsSource="{Binding InteractiveMap.Quests}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Multiple">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="30,5,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        Padding="2"
                                        Cursor="Hand"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Command="{Binding ToggleMapFiltersCommand}"
                    Cursor="Hand"
                    Style="{StaticResource IconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="24"
                        Height="24"
                        Kind="CloseBoxOutline" />
                </Button>
            </Grid>
        </Border>

        <i:Interaction.Triggers>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="True">
                <i:GoToStateAction StateName="Open" />
            </i:DataTrigger>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="False">
                <i:GoToStateAction StateName="Closed" />
            </i:DataTrigger>
            <i:EventTrigger EventName="MouseDown">
                <i:InvokeCommandAction Command="{Binding HideAllPanelsCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>

        <!--#endregion-->

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MenuStates">
                <VisualState x:Name="Closed">
                    <Storyboard>
                        <DoubleAnimation
                            EasingFunction="{StaticResource Ease}"
                            Storyboard.TargetName="FilterPanelTransform"
                            Storyboard.TargetProperty="X"
                            To="-300"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Open">
                    <Storyboard>
                        <DoubleAnimation
                            EasingFunction="{StaticResource Ease}"
                            Storyboard.TargetName="FilterPanelTransform"
                            Storyboard.TargetProperty="X"
                            To="10"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
