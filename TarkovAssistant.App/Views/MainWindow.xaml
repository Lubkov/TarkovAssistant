<Window
    x:Class="TarkovAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:TarkovAssistant.App.Behaviors"
    xmlns:core="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lang="clr-namespace:TarkovAssistant.App.Localization"
    xmlns:local="clr-namespace:TarkovAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TarkovAssistant.App.ViewModels"
    Title="{x:Static lang:Labels.AppName_Label}"
    Width="{Binding FormInfo.Width, Mode=TwoWay}"
    Height="{Binding FormInfo.Height, Mode=TwoWay}"
    MinWidth="800"
    MinHeight="600"
    Background="{StaticResource UltraDarkBaseBrush}"
    Cursor=""
    Left="{Binding FormInfo.Left, Mode=TwoWay}"
    ResizeMode="{Binding FormInfo.ResizeMode, Mode=TwoWay}"
    Top="{Binding FormInfo.Top, Mode=TwoWay}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="{Binding FormInfo.WindowStyle, Mode=TwoWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <CubicEase x:Key="Ease" EasingMode="EaseInOut" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </Window.Resources>

    <Grid Background="{StaticResource UltraDarkBaseBrush}" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <i:Interaction.Behaviors>
            <b:ActualSizeBehavior ActualHeight="{Binding InteractiveMap.ContainerHeight, Mode=TwoWay}" />
            <b:ActualSizeBehavior ActualWidth="{Binding InteractiveMap.ContainerWidth, Mode=TwoWay}" />
        </i:Interaction.Behaviors>

        <!--#region <Actions> -->

        <Grid
            Grid.RowSpan="2"
            Grid.Column="0"
            Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Width="Auto"
                Margin="10,10,0,0"
                Orientation="Vertical">

                <Button
                    Command="{Binding SelectMapCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="Apps" />
                </Button>

                <Button
                    Margin="0,20,0,0"
                    Command="{Binding ToggleFullScreenCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="Fullscreen" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ZoomInCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MagnifyPlusOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ZoomOutCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MagnifyMinusOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding CenterMapCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="ImageFilterCenterFocusStrong" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding ToggleMapFiltersCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="FilterCogOutline" />
                </Button>

                <Button
                    Margin="0,10,0,0"
                    Command="{Binding TestCurrentPositionCommand}"
                    Cursor="Hand"
                    Style="{StaticResource BigIconButtonStyle}"
                    Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVisible}}">
                    <icons:PackIconMaterial
                        Width="40"
                        Height="40"
                        Kind="MapMarkerStarOutline" />
                </Button>
            </StackPanel>

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,0,0,10"
                VerticalAlignment="Bottom"
                Command="{Binding OpenSettingsCommand}"
                Cursor="Hand"
                Style="{StaticResource BigIconButtonStyle}">
                <icons:PackIconMaterial
                    Width="40"
                    Height="40"
                    Kind="Cog" />
            </Button>
        </Grid>

        <!--#endregion-->

        <!--#region <Map Container> -->

        <Canvas
            Name="MapContainer"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="0"
            Cursor="">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding HideAllPanelsCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <Canvas
                Canvas.Left="{Binding InteractiveMap.ContainerLeft}"
                Canvas.Top="{Binding InteractiveMap.ContainerTop}"
                Width="Auto"
                Height="Auto"
                Cursor="">

                <i:Interaction.Behaviors>
                    <b:DragBehavior />
                </i:Interaction.Behaviors>

                <Image
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="{Binding InteractiveMap.Width, Mode=TwoWay}"
                    Height="{Binding InteractiveMap.Height, Mode=TwoWay}"
                    Canvas.ZIndex="0"
                    Cursor="ScrollAll"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding InteractiveMap.CurrentLayer.Picture}">

                    <Image.CacheMode>
                        <BitmapCache />
                    </Image.CacheMode>
                </Image>

                <Canvas
                    Canvas.Left="{Binding InteractiveMap.CurrentPosition.Left}"
                    Canvas.Top="{Binding InteractiveMap.CurrentPosition.Top}"
                    Width="32"
                    Height="32"
                    Canvas.ZIndex="2"
                    Visibility="{Binding InteractiveMap.CurrentPosition.IsVisibile, Converter={StaticResource BoolToVisible}}">

                    <Canvas
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="32"
                        Height="32">
                        <Ellipse
                            Canvas.Left="6"
                            Canvas.Top="6"
                            Width="20"
                            Height="20"
                            Fill="Crimson" />
                        <Polygon
                            x:Name="Triangle"
                            Fill="Crimson"
                            Points="16,0 10,5 22,5"
                            Stroke="Crimson"
                            StrokeThickness="2" />

                        <Canvas.RenderTransform>
                            <RotateTransform Angle="{Binding InteractiveMap.CurrentPosition.Angle}" CenterX="16" CenterY="16" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </Canvas>

                <Canvas>
                    <ItemsControl Cursor="" ItemsSource="{Binding InteractiveMap.Markers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <Setter Property="Canvas.ZIndex" Value="1" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image
                                    Width="32"
                                    Height="32"
                                    Cursor="Hand"
                                    Source="{Binding Picture}"
                                    Visibility="{Binding IsVisibile, Converter={StaticResource BoolToVisible}}">

                                    <i:Interaction.Behaviors>
                                        <b:ClickBehavior Command="{Binding DataContext.MarkerClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </i:Interaction.Behaviors>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </Canvas>
            </Canvas>


        </Canvas>
        <!--#endregion-->

        <!--#region <Map Selection Panel> -->

        <Border
            Name="MapSelection"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Width="Auto"
            Height="Auto"
            MinWidth="600"
            MinHeight="220"
            MaxWidth="1120"
            MaxHeight="520"
            Margin="20"
            Padding="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2"
            d:Visibility="Collapsed"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource MediumFocudedBrush}"
            BorderThickness="1"
            Cursor=""
            Visibility="{Binding IsMapSelectionPanelVisible, Converter={StaticResource BoolToVisible}}">

            <ListBox
                x:Name="MapListBox"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Maps}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedMap, Mode=TwoWay}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template" Value="{StaticResource MapListItems}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!--#endregion-->

        <!--#region <Marker info Panel> -->

        <Border
            Name="MarkerPanel"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Width="580"
            Height="Auto"
            Margin="20"
            Padding="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="5"
            d:Visibility="Collapsed"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource MediumFocudedBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Cursor=""
            Visibility="{Binding IsMarkerInfoPanelVisible, Converter={StaticResource BoolToVisible}}">

            <Grid Width="Auto" Height="Auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="64"
                        d:Source="/Resources/Images/Traders/trader_prapor.png"
                        Source="{Binding InteractiveMap.CurrentMarker.TraderPicture}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="10,5,10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="Marker description"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Big}"
                        Foreground="{StaticResource LightBrush}"
                        Text="{Binding InteractiveMap.CurrentMarker.Description}" />

                    <Grid Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding HideMarkerPanelCommand}"
                                Cursor="Hand"
                                Style="{StaticResource SimpleIconButtonStyle}">
                                <icons:PackIconMaterial
                                    Width="24"
                                    Height="24"
                                    Kind="CloseBoxOutline" />
                            </Button>

                            <CheckBox
                                Grid.Row="1"
                                Margin="0,0,5,0"
                                VerticalAlignment="Bottom"
                                Content="{x:Static lang:Labels.Completed_Label}"
                                FontFamily="{StaticResource BaseFont}"
                                FontSize="{StaticResource Regular}"
                                Foreground="{StaticResource LightBrush}"
                                IsChecked="{Binding InteractiveMap.CurrentMarker.IsFinished, Mode=TwoWay}" />
                        </Grid>
                    </Grid>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    MinHeight="40"
                    Margin="10,5,10,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Regular}"
                    Foreground="{StaticResource LightBrush}"
                    Text="{Binding InteractiveMap.CurrentMarker.CurrentScreenshot.Description}"
                    TextWrapping="Wrap" />

                <ListBox
                    Grid.Row="2"
                    Height="52"
                    Background="{StaticResource DarkBaseBrush}"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource MarkerHorizontalItemStyle}"
                    ItemsSource="{Binding InteractiveMap.CurrentMarker.Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    Visibility="{Binding InteractiveMap.CurrentMarker.IsHorizontalItemListVisible}">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Height="Auto"
                        MinWidth="640"
                        MinHeight="360"
                        Margin="2"
                        Source="{Binding InteractiveMap.CurrentMarker.CurrentScreenshot.Picture}" />

                    <ListBox
                        Grid.Column="1"
                        Width="52"
                        Background="{StaticResource DarkBaseBrush}"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource MarkerVerticalItemStyle}"
                        ItemsSource="{Binding InteractiveMap.CurrentMarker.Items}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding InteractiveMap.CurrentMarker.IsVerticalItemListVisible}">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid VerticalAlignment="Top" Columns="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>

                <ListBox
                    Grid.Row="4"
                    Height="52"
                    Background="{StaticResource DarkBaseBrush}"
                    BorderThickness="0"
                    ItemsSource="{Binding InteractiveMap.CurrentMarker.Screenshots}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding InteractiveMap.CurrentMarker.CurrentScreenshot, Mode=TwoWay}"
                    Visibility="{Binding InteractiveMap.CurrentMarker.IsScreenshotListVisible}">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid HorizontalAlignment="Left" Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template" Value="{StaticResource ScreenshotListItems}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!--#endregion-->

        <!--#region <Settings Panel> -->

        <Border
            Name="SettingsPanel"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Width="520"
            Height="Auto"
            Padding="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="5"
            d:Visibility="Visible"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource MediumFocudedBrush}"
            BorderThickness="1"
            Cursor=""
            Visibility="{Binding IsSettingsPanelVisible, Converter={StaticResource BoolToVisible}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Big}"
                    Foreground="{StaticResource LightBrush}"
                    Text="Settings" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Command="{Binding HideSettingsPanelCommand}"
                    Cursor="Hand"
                    Style="{StaticResource SimpleIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="24"
                        Height="24"
                        Kind="CloseBoxOutline" />
                </Button>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="20,10,20,0"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Regular}"
                    Foreground="{StaticResource LightBrush}"
                    Text="Путь к системным данным программы:" />

                <TextBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="20,5,10,0"
                    Padding="2,3,2,3"
                    IsEnabled="False"
                    Style="{StaticResource BaseTextBox}"
                    Text="{Binding Options.DataPath, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="20,20,20,0"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Regular}"
                    Foreground="{StaticResource LightBrush}"
                    Text="Путь к скриншотам игры:" />

                <TextBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="20,5,10,0"
                    Padding="2,3,2,3"
                    Style="{StaticResource BaseTextBox}"
                    Text="{Binding Options.SreenshotPath, Mode=TwoWay}" />

                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="Auto"
                    Height="Auto"
                    Margin="0,5,10,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenScreenshotPathCommand}"
                    Cursor="Hand"
                    Style="{StaticResource SimpleIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="28"
                        Height="28"
                        Kind="FolderOpenOutline" />
                </Button>

                <CheckBox
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="20,20,20,0"
                    Content="Отслеживать местоположении"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Regular}"
                    Foreground="{StaticResource LightBrush}"
                    IsChecked="{Binding Options.TrackLocation, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="20,20,20,0"
                    FontFamily="{StaticResource BaseFont}"
                    FontSize="{StaticResource Regular}"
                    Foreground="{StaticResource LightBrush}"
                    Text="Игровой профиль:" />

                <Grid
                    Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        Margin="20,0,10,0"
                        Padding="0,2,0,2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}"
                        ItemsSource="{Binding Options.Profiles, Mode=TwoWay}"
                        SelectedItem="{Binding Options.CurrentProfile, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <!--  Command="{Binding SelectMapCommand}"  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Command="{Binding AddProfileCommand}"
                            Cursor="Hand"
                            Style="{StaticResource SimpleIconButtonStyle}">
                            <icons:PackIconMaterial
                                Width="32"
                                Height="32"
                                Kind="FileDocumentPlusOutline" />
                        </Button>

                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding EditProfileCommand}"
                            CommandParameter="{Binding Options.CurrentProfile}"
                            Cursor="Hand"
                            Style="{StaticResource SimpleIconButtonStyle}">
                            <icons:PackIconMaterial
                                Width="32"
                                Height="32"
                                Kind="FileDocumentEditOutline" />
                        </Button>

                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding RemoveProfileCommand}"
                            CommandParameter="{Binding Options.CurrentProfile}"
                            Cursor="Hand"
                            Style="{StaticResource SimpleIconButtonStyle}">
                            <icons:PackIconMaterial
                                Width="32"
                                Height="32"
                                Kind="FileDocumentRemoveOutline" />
                        </Button>

                        <Button
                            Margin="5,0,5,0"
                            Command="{Binding ClearProfileCommand}"
                            Cursor="Hand"
                            Style="{StaticResource SimpleIconButtonStyle}">
                            <icons:PackIconMaterial
                                Width="32"
                                Height="32"
                                Kind="TrashCanOutline" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region <Filter Panel> -->

        <Border
            Name="FilterPanel"
            Grid.RowSpan="2"
            Width="300"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            Panel.ZIndex="2"
            Background="{StaticResource DarkBaseBrush}"
            BorderBrush="{StaticResource MediumFocudedBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Cursor=""
            RenderTransformOrigin="0,0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTransform" X="-300" />
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,10,50,0"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}">

                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Extractions_Label}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor=""
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        ItemContainerStyle="{StaticResource FilterListItems}"
                        ItemsSource="{Binding InteractiveMap.Extractions}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Multiple">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="30,5,0,0" Orientation="Horizontal">
                                    <Image Width="32" Source="{Binding Icon}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        Padding="2"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat=" {0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="Markers.Count" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="2"
                        Margin="10,20,0,0"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        Foreground="{StaticResource LightBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:">
                                <Binding Source="{x:Static lang:Labels.Quests_Label}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ListBox
                        Grid.Row="3"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor=""
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        ItemContainerStyle="{StaticResource FilterListItems}"
                        ItemsSource="{Binding InteractiveMap.Quests}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Multiple">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="30,5,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        Padding="2"
                                        Cursor="Hand"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Command="{Binding ToggleMapFiltersCommand}"
                    Cursor="Hand"
                    Style="{StaticResource SimpleIconButtonStyle}">
                    <icons:PackIconMaterial
                        Width="24"
                        Height="24"
                        Kind="CloseBoxOutline" />
                </Button>
            </Grid>
        </Border>

        <i:Interaction.Triggers>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="True">
                <i:GoToStateAction StateName="Open" />
            </i:DataTrigger>
            <i:DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="False">
                <i:GoToStateAction StateName="Closed" />
            </i:DataTrigger>
        </i:Interaction.Triggers>


        <!--#endregion-->

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MenuStates">
                <VisualState x:Name="Closed">
                    <Storyboard>
                        <DoubleAnimation
                            EasingFunction="{StaticResource Ease}"
                            Storyboard.TargetName="FilterPanelTransform"
                            Storyboard.TargetProperty="X"
                            To="-300"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Open">
                    <Storyboard>
                        <DoubleAnimation
                            EasingFunction="{StaticResource Ease}"
                            Storyboard.TargetName="FilterPanelTransform"
                            Storyboard.TargetProperty="X"
                            To="10"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
