<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="MapListItems" TargetType="ListBoxItem">
        <Grid>
            <Border
                Name="brd"
                MaxWidth="210"
                Margin="5,5,5,5"
                Padding="4"
                Background="{StaticResource DarkBaseBrush}"
                BorderBrush="{StaticResource MediumBaseBrush}"
                BorderThickness="2"
                CornerRadius="4"
                Cursor="Hand">

                <StackPanel>
                    <Image Name="img" Source="{Binding Picture}" />
                    <TextBlock
                        Name="txt"
                        Margin="5,2,5,2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BaseFont}"
                        FontSize="{StaticResource Regular}"
                        FontStretch="UltraExpanded"
                        FontWeight="Bold"
                        Foreground="{StaticResource LightBrush}"
                        Style="{StaticResource BaseText}"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="brd" Property="Background" Value="{StaticResource DarkBaseBrush}" />
                <Setter TargetName="brd" Property="BorderBrush" Value="{StaticResource BaseFocudedBrush}" />
                <Setter TargetName="img" Property="Opacity" Value="0.75" />
                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource MediumBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FilterListItems" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{Binding FontColor}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FilterFocusedBrush}" />
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{Binding PressedFontColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ScreenshotListItems" TargetType="ListBoxItem">
        <Grid>
            <Border
                Name="border"
                MaxWidth="85"
                MaxHeight="48"
                Margin="2,2,2,2"
                BorderBrush="{StaticResource DarkBaseBrush}"
                BorderThickness="1"
                Cursor="Hand">

                <Border
                    x:Name="innerBorder"
                    Background="{StaticResource DarkBaseBrush}"
                    BorderBrush="{StaticResource DarkBaseBrush}"
                    BorderThickness="1">

                    <Image Name="icon" Source="{Binding Picture}" />
                </Border>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="innerBorder" Property="BorderBrush" Value="{StaticResource BaseFocudedBrush}" />
                <Setter TargetName="icon" Property="Opacity" Value="0.8" />
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BaseFocudedBrush}" />
                <Setter TargetName="innerBorder" Property="BorderBrush" Value="{StaticResource BaseFocudedBrush}" />
                <Setter TargetName="icon" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Marker items style  -->
    <ControlTemplate x:Key="MarkerItemTemplate" TargetType="ListBoxItem">
        <Grid>
            <Border
                Name="brd"
                Margin="0,2,0,2"
                Background="{StaticResource LightBaseBrush}"
                BorderThickness="0"
                Cursor="">
                <Image Name="img" Source="{Binding Picture}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="MarkerVerticalItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template" Value="{StaticResource MarkerItemTemplate}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MaxWidth" Value="48" />
    </Style>

    <Style x:Key="MarkerHorizontalItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template" Value="{StaticResource MarkerItemTemplate}" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MaxHeight" Value="48" />
    </Style>

</ResourceDictionary>