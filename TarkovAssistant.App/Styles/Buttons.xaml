<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="BaseIconButtonTemplate" TargetType="Button">
        <Border
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{DynamicResource BorderCornerRadius}">

            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SimpleIconButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource BaseIconButtonTemplate}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LightBrush}" />

        <Style.Resources>
            <SolidColorBrush x:Key="ButtonMouseOverBrush" Color="{StaticResource MediumBaseColor}" />
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource UltraBaseColor}" />
            <CornerRadius
                x:Key="BorderCornerRadius"
                BottomLeft="6"
                BottomRight="6"
                TopLeft="6"
                TopRight="6" />
        </Style.Resources>
    </Style>

    <Style
        x:Key="BigIconButtonStyle"
        BasedOn="{StaticResource SimpleIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkBaseBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBaseBrush}" />
        <Setter Property="Padding" Value="5" />

        <Style.Resources>
            <SolidColorBrush x:Key="ButtonMouseOverBrush" Color="{StaticResource MediumBaseColor}" />
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource UltraBaseColor}" />
        </Style.Resources>
    </Style>

    <ControlTemplate x:Key="BaseTextButtonTemplate" TargetType="Button">
        <Border
            x:Name="border"
            BorderBrush="Transparent"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="4">

            <Border
                x:Name="innerBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BaseFocudedBrush}" />
                <Setter TargetName="innerBorder" Property="BorderBrush" Value="{DynamicResource FocusedInnerBorderBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BaseTextButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource BaseTextButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource DarkBaseBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LightBaseBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LightBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BaseFont}" />
        <Setter Property="FontSize" Value="{StaticResource Smal}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="4,6,4,6" />
        <Setter Property="BorderThickness" Value="1" />

        <Style.Resources>
            <SolidColorBrush x:Key="FocusedInnerBorderBrush" Color="{StaticResource BaseFocudedColor}" />
        </Style.Resources>
    </Style>

    <Style
        x:Key="SuccessTextButtonStyle"
        BasedOn="{StaticResource BaseTextButtonStyle}"
        TargetType="Button">
        <Setter Property="BorderThickness" Value="2" />

        <Style.Resources>
            <SolidColorBrush x:Key="FocusedInnerBorderBrush" Color="{StaticResource BaseColor}" />
        </Style.Resources>
    </Style>


    <Style x:Key="MarkerButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Padding="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>